# Swar Music Player Backend Environment Configuration
PORT=3001
NODE_ENV=production

# Groq Cloud Whisper API Key for AI Audio-to-Text Transcription
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=

# Allowed CORS origins (comma-separated, or * for all)
CORS_ORIGIN=*

# Optional: Genius API Token (for Genius lyrics lookup)
# https://genius.com/api-clients
GENIUS_ACCESS_TOKEN=

# Optional: RapidAPI Key (for Musixmatch fallback)
# https://rapidapi.com
RAPIDAPI_KEY=
