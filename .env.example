# Swar Music Player Frontend Environment Configuration

# Render Backend API URL (e.g. https://swar-player-api.onrender.com)
VITE_API_BASE_URL=https://swar-player-api.onrender.com

# Optional client-side Groq Cloud Whisper API Key fallback
# Get a free key at https://console.groq.com/keys
VITE_GROQ_API_KEY=your_groq_api_key_here
